{
  "name": "mydesk-desktop",
  "productName": "MyDesk",
  "version": "1.2.0",
  "description": "MyDesk for Windows",
  "author": {
    "name": "Alif Mahmud",
    "email": "info@alifmahmud.com",
    "url": "https://alifmahmud.com"
  },
  "homepage": "https://alifmahmud.com",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.alifmahmud.mydesk",
    "productName": "MyDesk",
    "copyright": "Copyright © 2026 Alif Mahmud (alifmahmud.com)",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "MyDesk-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyDesk"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alifmahmudashik",
        "repo": "mydesk"
      }
    ]
  },
  "allowScripts": {
    "electron@38.8.6": true
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
