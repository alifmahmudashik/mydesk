# Copy to .env and fill in. Leave the VITE_ values empty to run MyDesk in demo mode
# (seeded sample data, stored in your browser). Never put real keys in this file:
# it is committed to GitHub.

# --- Browser (safe to expose) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server only (Vercel → Settings → Environment Variables; used by /api) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=MyDesk <notifications@yourdomain.com>
APP_URL=http://localhost:3000
CRON_SECRET=
